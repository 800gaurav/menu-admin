# Backend API URL (must include /api)
# Local: http://localhost:5000/api
# Production example: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# User (Diner Menu) URL
# Local: http://localhost:5173
# Production (same domain as admin): leave blank or set to https://admin.yourdomain.com
VITE_USER_URL=http://localhost:5173

# Waiter POS Panel URL
# Local: http://localhost:5174
# Production (same domain as admin): leave blank or set to https://admin.yourdomain.com
VITE_WAITER_URL=http://localhost:5174
